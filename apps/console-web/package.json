{
  "name": "console-web",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:domain-migration": "node scripts/check-domain-migration.mjs",
    "test": "npm run test:editorial && npm run check:editorial && npm run i18n:check && vitest run",
    "test:watch": "vitest",
    "check:editorial": "node scripts/check-editorial.mjs",
    "test:editorial": "node --test scripts/check-editorial.test.mjs",
    "i18n:extract": "node scripts/extract-messages.mjs",
    "i18n:sync-emails": "node scripts/sync-account-messages.mjs",
    "i18n:check": "node scripts/extract-messages.mjs --check && node scripts/sync-account-messages.mjs --check"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^25.0.1",
    "sass": "^1.101.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
