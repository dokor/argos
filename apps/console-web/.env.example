# Copy to .env.local; keep real credentials outside Git.
API_BASE=http://localhost:8081
ACCOUNT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PRODUCT_ANALYTICS_ENABLED=false

# Server-only credential, matching Java admin-api.token / ADMIN_API_TOKEN.
# Also required for consented analytics collection when enabled, independently
# of operator login and account sessions. Do not remove with the legacy cookie.
ADMIN_API_TOKEN=
