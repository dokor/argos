# Copy to .env.local; keep real credentials outside Git.
API_BASE=http://localhost:8081
ACCOUNT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PRODUCT_ANALYTICS_ENABLED=false

# Optional legacy admin access: generate distinct secrets and set ADMIN_API_TOKEN
# to the same server-only value as the Java backend. Empty values disable access.
ADMIN_PASSWORD=
ADMIN_TOKEN=
ADMIN_API_TOKEN=
