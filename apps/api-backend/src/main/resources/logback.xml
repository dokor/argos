<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <turboFilter class="com.dokor.argos.jersey.JerseyLogbackFilter" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- [run:… mod:…] = contexte MDC de corrélation (issue #41), vide hors pipeline d'audit -->
      <pattern>%d{HH:mm:ss.SSS} %-5level [run:%X{runId:-} mod:%X{module:-}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  
  <logger name="com.dokor.argos" level="DEBUG"/>
  
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>