{
  "openapi": "3.1.0",
  "info": {
    "title": "Argos Premium CI API",
    "version": "1.0.0-preview",
    "description": "Preview contract. premium-ci.enabled=false until complete acceptance #467. Bearer machine key required on every call. Unknown query parameters are rejected. No cookie/admin/report-token substitution; no anonymous fallback. Responses and errors are private no-store. Body <=8192 bytes. Private details-v1 JSON exports are bounded to 65536 bytes. Verdicts (#466) and publication clients are separate contracts."
  },
  "servers": [
    {
      "url": "/api/ci/v1"
    }
  ],
  "security": [
    {
      "argosCiApiKey": []
    }
  ],
  "paths": {
    "/analyses": {
      "post": {
        "summary": "Admit full analyses atomically; recover the same intention after ambiguity.",
        "x-required-scopes": [
          "audits:write"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
              "maxLength": 36
            },
            "description": "Generate once, persist and reuse the same UUID for this intention, including after rotation/timeout."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing matching intention; no new analysis or execution debit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admission"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "201": {
            "description": "Fresh admission: all runs and reservations committed together.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admission"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/admissions/by-key/{key}": {
      "get": {
        "summary": "Recover the original intention using its key; missing/out-of-scope is uniform 404.",
        "x-required-scopes": [
          "results:read"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
              "maxLength": 36
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admission"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/admissions/{id}": {
      "get": {
        "summary": "Read this integration's admission.",
        "x-required-scopes": [
          "results:read"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
              "maxLength": 36
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admission"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "summary": "Read safe progress and a controlled terminal failure code.",
        "x-required-scopes": [
          "results:read"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19,
              "description": "Positive signed 64-bit run identifier; never an access credential."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/runs/{id}/report": {
      "get": {
        "summary": "Read summary-v1 only after publication; absent, pending, expired and out-of-scope report is uniform 404.",
        "x-required-scopes": [
          "results:read"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19,
              "description": "Positive signed 64-bit run identifier; never an access credential."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      },
      "delete": {
        "summary": "Idempotently delete a terminal private report and diagnostics, preserving accounting and the original intention.",
        "x-required-scopes": [
          "audits:write",
          "results:read"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19,
              "description": "Positive signed 64-bit run identifier; never an access credential."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized private response; no raw collector or target content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deletion"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/usage": {
      "get": {
        "summary": "Read this stable integration's ledger, including after downgrade.",
        "x-required-scopes": [
          "usage:read"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/preflight": {
      "get": {
        "summary": "Read rights/target states/usage without DNS, proof mutation, reservation or target contact.",
        "x-required-scopes": [
          "usage:read"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preflight"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/identity": {
      "get": {
        "summary": "Read current key identity and declared scope; not proof of admission eligibility.",
        "x-required-scopes": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Authorized private response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    },
    "/runs/{id}/export": {
      "get": {
        "summary": "Read details-v1 JSON, at most 65536 bytes; no raw evidence or public sharing link.",
        "x-required-scopes": [
          "results:read"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19,
              "description": "Positive signed 64-bit run identifier; never an access credential."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized private response; no raw collector or target content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "no-referrer"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/CiError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "argosCiApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Argos CI API key",
        "description": "Dedicated scoped, expiring machine credential; never a browser JWT or public report token."
      }
    },
    "schemas": {
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "samples",
          "profileId"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048,
            "description": "Public HTTPS URL on a verified origin. Queries, fragments, credentials and private targets are rejected."
          },
          "samples": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "profileId": {
            "const": "standard-v1",
            "type": "string"
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sample",
          "status",
          "createdAt",
          "startedAt",
          "finishedAt",
          "failureCode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19,
            "description": "Positive signed 64-bit run identifier; never an access credential."
          },
          "sample": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 40
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 40
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "RUN_FAILED",
              null
            ],
            "description": "RUN_FAILED only for FAILED. Controlled catalog code; no raw worker error."
          }
        }
      },
      "Admission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "id",
          "profileId",
          "samples",
          "createdAt",
          "runs"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "maxLength": 36
          },
          "profileId": {
            "const": "standard-v1"
          },
          "samples": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/components/schemas/Run"
            }
          }
        }
      },
      "UsageSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period",
          "timezone",
          "startsAt",
          "resetsAt",
          "used",
          "reserved",
          "limit",
          "available"
        ],
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "resetsAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reserved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "usage"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "usage": {
            "$ref": "#/components/schemas/UsageSnapshot"
          }
        }
      },
      "Preflight": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "newAccessAllowed",
          "scopes",
          "targets",
          "usage"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "newAccessAllowed": {
            "type": "boolean",
            "description": "Current Premium/ci_access only. This is not an admission guarantee or capacity reservation."
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "audits:write",
                "results:read",
                "usage:read"
              ]
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "origin",
                "state",
                "authorizedForKey"
              ],
              "properties": {
                "origin": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 261,
                  "description": "Exact verified HTTPS origin. No wildcard, credentials, query, path or nonstandard port."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "PENDING",
                    "VERIFIED",
                    "REVOKED",
                    "EXPIRED"
                  ]
                },
                "authorizedForKey": {
                  "type": "boolean"
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/UsageSnapshot"
          }
        }
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "kind",
          "runId",
          "globalScore",
          "scoringVersion",
          "criticalCount",
          "importantCount",
          "completeness",
          "generatedAt",
          "expiresAt"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "kind": {
            "const": "summary-v1"
          },
          "runId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19,
            "description": "Positive signed 64-bit run identifier; never an access credential."
          },
          "globalScore": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "scoringVersion": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "criticalCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "importantCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completeness": {
            "type": "string",
            "enum": [
              "FULL",
              "PARTIAL",
              "UNKNOWN"
            ]
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 40
          }
        }
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "integrationId",
          "keyId",
          "scopes",
          "origins"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "integrationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "maxLength": 36
          },
          "keyId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "audits:write",
                "results:read",
                "usage:read"
              ]
            }
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 261,
              "description": "Exact verified HTTPS origin. No wildcard, credentials, query, path or nonstandard port."
            }
          }
        }
      },
      "Error": {
        "$ref": "../../apps/api-backend/src/main/resources/ci/error-response-v1.schema.json"
      },
      "Export": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "kind",
          "summary",
          "reportPath",
          "details",
          "artifactPolicy",
          "publicIssue"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "kind": {
            "const": "details-v1"
          },
          "summary": {
            "$ref": "#/components/schemas/Report"
          },
          "reportPath": {
            "type": "string",
            "pattern": "^/api/ci/v1/runs/[1-9][0-9]{0,18}/report$"
          },
          "details": {
            "$ref": "#/components/schemas/ExportDetails"
          },
          "artifactPolicy": {
            "$ref": "#/components/schemas/ArtifactPolicy"
          },
          "publicIssue": {
            "$ref": "#/components/schemas/PublicIssue"
          }
        }
      },
      "ExportDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "categories",
          "checks",
          "findings",
          "omittedFindings"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "categories": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/ExportCategory"
            }
          },
          "checks": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/ExportCheck"
            }
          },
          "findings": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/ExportFinding"
            }
          },
          "omittedFindings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "ExportCategory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "score"
        ],
        "properties": {
