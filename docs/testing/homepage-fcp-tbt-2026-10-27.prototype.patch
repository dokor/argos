diff --git a/apps/console-web/next.config.ts b/apps/console-web/next.config.ts
index 0a883283..c6766eca 100644
--- a/apps/console-web/next.config.ts
+++ b/apps/console-web/next.config.ts
@@ -1,4 +1,10 @@
 import type { NextConfig } from "next";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const fontAssets: { assets: { href: string }[] } = JSON.parse(
+  readFileSync(join(__dirname, "src/styles/geist-assets.json"), "utf8"),
+);
 
 // En-têtes de sécurité HTTP appliqués à toutes les routes.
 // Objectif : remonter le score Mozilla Observatory et réduire la surface
@@ -21,10 +27,9 @@ const securityHeaders = [
 
 const nextConfig: NextConfig = {
   poweredByHeader: false,
-  // console-web has its own dependencies and lockfile, separate from root ADE tooling.
-  // The config directory also resolves to /app in the console-web Docker context.
-  turbopack: { root: __dirname },
-  experimental: { globalNotFound: true },
+  outputFileTracingRoot: __dirname,
+  // Keep Webpack's ordinary route CSS extraction; disable Next's experimental cross-route merging.
+  experimental: { globalNotFound: true, cssChunking: false },
   reactCompiler: true,
   async redirects() {
     return [
@@ -36,6 +41,7 @@ const nextConfig: NextConfig = {
   },
   async headers() {
     return [
+      ...fontAssets.assets.map(asset => ({ source: asset.href, headers: [{ key: "Cache-Control", value: "public, max-age=31536000, immutable" }] })),
       { source: "/report/:path*", headers: [{ key: "X-Robots-Tag", value: "noindex, nofollow" }] },
       { source: "/en/report/:path*", headers: [{ key: "X-Robots-Tag", value: "noindex, nofollow" }] },
       {
