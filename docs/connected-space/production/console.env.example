# Candidate only. Keep filled copies outside Git, readable only by the operator.
# API_BASE is server-only and has no /api suffix.
API_BASE=http://api-backend:8081
ACCOUNT_ORIGIN=https://argos.lelouet.fr
# Dedicated server token, identical to backend admin-api.token, distinct from JWT.
# Fill via the secret manager; respect Docker Compose env-file quoting rules.
ADMIN_API_TOKEN=
# Do not add ADMIN_TOKEN or ADMIN_PASSWORD (retired browser authentication).
